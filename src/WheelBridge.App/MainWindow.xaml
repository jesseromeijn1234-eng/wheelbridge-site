<Window x:Class="WheelBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WheelBridge" Height="700" Width="1050" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock FontSize="27" FontWeight="ExtraBold"><Run Text="WHEEL"/><Run Text="BRIDGE" Foreground="{StaticResource Accent}"/></TextBlock><TextBlock Text="Your wheel setup, in one place." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="DEVICE STATUS" Foreground="{StaticResource Mint}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Connect your racing wheel" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Your connected wheel will appear here once device detection is added." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Border Background="#0D131D" CornerRadius="10" Padding="14" Margin="0,20,0,12"><StackPanel><TextBlock Text="NO WHEEL SCAN YET" Foreground="#E8D28B" FontWeight="Bold"/><TextBlock Text="This development build does not read live wheel input yet." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="LOCAL PROFILE" Foreground="{StaticResource Mint}" FontWeight="Bold" FontSize="11" Margin="0,20,0,6"/><TextBlock Text="Settings will be stored on this PC, independently of your Roblox account." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="INPUT LAB" Foreground="{StaticResource Mint}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Test the controls" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,4"/><TextBlock Text="Move the sliders to preview steering and pedals. This is only a local simulation." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
<TextBlock Text="STEERING" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SteeringValue" Text="0%" FontSize="28" FontWeight="Bold" Margin="0,3,0,0"/><Slider x:Name="SteeringSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="InputChanged" Margin="0,8,0,22"/>
<TextBlock Text="THROTTLE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"/><Slider x:Name="ThrottleSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="InputChanged" Margin="0,7,0,18"/><TextBlock x:Name="ThrottleValue" Text="0%" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,-16,0,15"/>
<TextBlock Text="BRAKE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"/><Slider x:Name="BrakeSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="InputChanged" Margin="0,7,0,18"/><TextBlock x:Name="BrakeValue" Text="0%" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,-16,0,15"/>
<TextBlock Text="CLUTCH" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"/><Slider x:Name="ClutchSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="InputChanged" Margin="0,7,0,18"/><TextBlock x:Name="ClutchValue" Text="0%" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,-16,0,15"/>
<Button Content="Reset test input" Click="Reset_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></Grid>
<Border Grid.Row="3" Background="#171D28" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0"><TextBlock Text="EARLY DEVELOPMENT BUILD  •  No live wheel input, virtual controller, Roblox connection or force feedback yet." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></Border>
</Grid></Window>