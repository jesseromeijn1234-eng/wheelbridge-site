<Window x:Class="WheelBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelBridge"
        Width="1040"
        Height="730"
        MinWidth="900"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="ExtraBold">
                <Run Text="WHEEL"/>
                <Run Text="BRIDGE" Foreground="{StaticResource Accent}"/>
            </TextBlock>
            <TextBlock Text="Your wheel setup, in one place."
                       Foreground="{StaticResource Muted}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="DEVICE CONNECTION"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBlock Text="Find your racing wheel"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,9,0,6"/>
                    <TextBlock Text="WheelBridge scans Windows DirectInput devices and lists connected controllers."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>

                    <Button Content="Scan for devices"
                            Click="ScanDevices_Click"
                            HorizontalAlignment="Left"
                            Margin="0,20,0,16"/>

                    <Border Background="#0D141E"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="SCAN STATUS"
                                       Foreground="{StaticResource Muted}"
                                       FontWeight="Bold"
                                       FontSize="10"/>
                            <TextBlock x:Name="DeviceStatusText"
                                       Text="Starting device scan…"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DETECTED CONTROLLERS"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,24,0,8"/>
                    <ComboBox x:Name="DeviceSelector"
                              Height="40"
                              Padding="9,5"
                              DisplayMemberPath="ProductName"
                              SelectionChanged="DeviceSelector_SelectionChanged"
                              IsEnabled="False"/>

                    <TextBlock Text="Keep your wheel connected and switched on while scanning. Some wheels may require their manufacturer driver."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"/>

                    <TextBlock Text="NEXT UP"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,28,0,7"/>
                    <TextBlock Text="Assigning steering, throttle, brake, clutch and buttons comes after this device-input layer."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="LIVE INPUT MONITOR"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBlock Text="Controller signals"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>
                    <TextBlock x:Name="InputMonitorStatus"
                               Text="Select a controller to view live input."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="X AXIS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="XAxisValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="Y AXIS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="YAxisValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="Z AXIS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ZAxisValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="ROTATION X" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="RotationXValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Grid.Column="0" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="ROTATION Y" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="RotationYValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="2" Background="#0D141E" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="ROTATION Z" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="RotationZValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0D141E" CornerRadius="10" Padding="13" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SLIDERS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="SliderValues" Text="—  /  —" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0D141E" CornerRadius="10" Padding="13" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PRESSED BUTTONS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ButtonsValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="These are raw DirectInput values. Axis names and pedal positions differ by wheel; control mapping comes next."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#171F2B"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,18,0,0">
            <TextBlock Text="EARLY DEVELOPMENT BUILD  •  DirectInput device scanning and live raw-axis reading are now included. Roblox connection, virtual controller and force feedback are still in development."
                       Foreground="{StaticResource Muted}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
