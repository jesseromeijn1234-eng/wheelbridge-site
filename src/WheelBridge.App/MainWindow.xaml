<Window x:Class="WheelBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelBridge"
        Width="1040"
        Height="700"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="ExtraBold">
                <Run Text="WHEEL"/>
                <Run Text="BRIDGE" Foreground="{StaticResource Accent}"/>
            </TextBlock>
            <TextBlock Text="Your wheel setup, in one place."
                       Foreground="{StaticResource Muted}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="DEVICE STATUS"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBlock Text="Connect your racing wheel"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,9,0,6"/>
                    <TextBlock Text="Connected wheel detection is not included in this build yet."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>

                    <Border Background="#0D141E"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="LIVE DEVICE SCAN: NOT AVAILABLE"
                                       Foreground="#E8D28B"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="This version is an interface preview. It does not read a physical wheel."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="WHAT'S NEXT"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,26,0,7"/>
                    <TextBlock Text="The next development step is reading steering, pedals and buttons from supported wheel drivers."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="INPUT LAB"
                               Foreground="{StaticResource Mint}"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBlock Text="Test the controls"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>
                    <TextBlock Text="Move these sliders to preview the interface. They are simulated values, not readings from your wheel."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="STEERING"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="SteeringValue"
                               Text="0%"
                               FontSize="27"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                    <Slider x:Name="SteeringSlider"
                            Minimum="-100"
                            Maximum="100"
                            Value="0"
                            ValueChanged="InputChanged"
                            Margin="0,6,0,19"/>

                    <TextBlock Text="THROTTLE"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"/>
                    <DockPanel Margin="0,5,0,4">
                        <TextBlock x:Name="ThrottleValue"
                                   Text="0%"
                                   Foreground="{StaticResource Muted}"
                                   DockPanel.Dock="Right"/>
                        <Slider x:Name="ThrottleSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                ValueChanged="InputChanged"/>
                    </DockPanel>

                    <TextBlock Text="BRAKE"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"
                               Margin="0,12,0,0"/>
                    <DockPanel Margin="0,5,0,4">
                        <TextBlock x:Name="BrakeValue"
                                   Text="0%"
                                   Foreground="{StaticResource Muted}"
                                   DockPanel.Dock="Right"/>
                        <Slider x:Name="BrakeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                ValueChanged="InputChanged"/>
                    </DockPanel>

                    <TextBlock Text="CLUTCH"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"
                               Margin="0,12,0,0"/>
                    <DockPanel Margin="0,5,0,4">
                        <TextBlock x:Name="ClutchValue"
                                   Text="0%"
                                   Foreground="{StaticResource Muted}"
                                   DockPanel.Dock="Right"/>
                        <Slider x:Name="ClutchSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                ValueChanged="InputChanged"/>
                    </DockPanel>

                    <Button Content="Reset test input"
                            Click="Reset_Click"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#171F2B"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,18,0,0">
            <TextBlock Text="EARLY DEVELOPMENT BUILD  •  No live wheel input, virtual controller, Roblox connection or force feedback yet."
                       Foreground="{StaticResource Muted}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
