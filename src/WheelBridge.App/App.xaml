<Application x:Class="WheelBridge.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0F17"/>
    <SolidColorBrush x:Key="Panel" Color="#151D2A"/>
    <SolidColorBrush x:Key="Line" Color="#2A374B"/>
    <SolidColorBrush x:Key="Accent" Color="#8CA7FF"/>
    <SolidColorBrush x:Key="Mint" Color="#63DFC7"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA8BD"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F6FC"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0B1020"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Application.Resources>
</Application>