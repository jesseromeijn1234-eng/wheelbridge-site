<Application x:Class="WheelBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0B1018"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#151E2B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2A394D"/>
        <SolidColorBrush x:Key="Accent" Color="#8CA7FF"/>
        <SolidColorBrush x:Key="Mint" Color="#63DFC7"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA9BD"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F3F6FC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0B1020"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
